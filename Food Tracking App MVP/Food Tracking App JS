import React, { useState, useEffect, useRef } from 'react';
import { List, PlusCircle, Settings, Download, Upload, Bell, AlertTriangle, CheckCircle, Trash2, Clock, CalendarDays, X, Search, Minus, Plus, Tag, Image as ImageIcon, Utensils } from 'lucide-react';

const FOOD_ICONS = [
  { id: 'general', emoji: '🍽️', label: 'General' },
  { id: 'milk', emoji: '🥛', label: 'Milk/Dairy' },
  { id: 'chicken', emoji: '🍗', label: 'Poultry' },
  { id: 'meat', emoji: '🥩', label: 'Meat' },
  { id: 'juice', emoji: '🧃', label: 'Juice' },
  { id: 'fruit', emoji: '🍎', label: 'Fruit' },
  { id: 'citrus', emoji: '🍊', label: 'Citrus' },
  { id: 'veg', emoji: '🥬', label: 'Vegetable' },
  { id: 'cheese', emoji: '🧀', label: 'Cheese' },
  { id: 'bread', emoji: '🍞', label: 'Bakery' },
  { id: 'fish', emoji: '🐟', label: 'Seafood' },
];

export default function App() {
  const [items, setItems] = useState([]);
  const [activeTab, setActiveTab] = useState('list');
  const [notificationPermission, setNotificationPermission] = useState('default');
  const [searchQuery, setSearchQuery] = useState('');

  // Category State
  const [categories, setCategories] = useState(['Uncategorized', 'Produce', 'Meat', 'Dairy', 'Pantry', 'Frozen']);
  const [newCategory, setNewCategory] = useState('');

  // Form State
  const [formData, setFormData] = useState({
    name: '',
    category: 'Uncategorized',
    quantity: '',
    expiryDate: '',
    image: null,
    icon: 'general',
    reminders: [
      { id: crypto.randomUUID(), daysBefore: 30 },
      { id: crypto.randomUUID(), daysBefore: 7 },
      { id: crypto.randomUUID(), daysBefore: 1 }
    ]
  });

  // Image Upload Handler (resizes for safe local storage)
  const handleImageUpload = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX_SIZE = 300; // Keep image size small for CSV export safety
        let width = img.width;
        let height = img.height;
        if (width > height && width > MAX_SIZE) {
          height *= MAX_SIZE / width;
          width = MAX_SIZE;
        } else if (height > MAX_SIZE) {
          width *= MAX_SIZE / height;
          height = MAX_SIZE;
        }
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);
        setFormData({...formData, image: canvas.toDataURL('image/jpeg', 0.8)});
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  };

  // Notification setup
  useEffect(() => {
    if ("Notification" in window) {
      setNotificationPermission(Notification.permission);
    }
  }, []);

  const requestNotificationPermission = async () => {
    if ("Notification" in window) {
      const permission = await Notification.requestPermission();
      setNotificationPermission(permission);
      if (permission === 'granted') {
        alert("Push notifications enabled!");
      }
    } else {
      alert("Your browser does not support standard push notifications. In-app alerts will be used instead.");
    }
  };

  const sendNotification = (title, body) => {
    if (notificationPermission === 'granted') {
      new Notification(title, { body, icon: '/favicon.ico' });
    }
    // Also show a temporary in-app alert for safety if running in environments where push is blocked
    console.log(`NOTIFICATION TRIGGERED: ${title} - ${body}`);
  };

  // The Notification Engine (Checks periodically)
  useEffect(() => {
    const checkInterval = setInterval(() => {
      const now = new Date();
      now.setHours(0,0,0,0); // Normalize to start of day for accurate day diffs

      setItems(prevItems => {
        let itemsUpdated = false;
        const newItems = prevItems.map(item => {
          if (!item.expiryDate || !item.reminders) return item;

          const expiryDate = new Date(item.expiryDate);
          expiryDate.setHours(0,0,0,0);
          const daysUntilExpiry = Math.round((expiryDate - now) / (1000 * 60 * 60 * 24));

          let itemModified = false;
          const updatedReminders = item.reminders.map(reminder => {
            // Trigger if not yet notified and we are within or exactly on the reminder day window
            if (!reminder.isNotified && daysUntilExpiry <= reminder.daysBefore) {
              let title = daysUntilExpiry <= 0 ? "Food Expired/Expiring Today!" : "Upcoming Food Expiry!";
              let body = `${item.name} expires in ${daysUntilExpiry} day(s) (on ${item.expiryDate}). Qty: ${item.quantity}.`;

              sendNotification(title, body);
              itemModified = true;
              itemsUpdated = true;
              return { ...reminder, isNotified: true };
            }
            return reminder;
          });

          if (itemModified) {
            return { ...item, reminders: updatedReminders };
          }
          return item;
        });

        return itemsUpdated ? newItems : prevItems;
      });

    }, 60000); // Check every minute

    return () => clearInterval(checkInterval);
  }, [notificationPermission]);

  // Handlers
  const handleAddItem = (e) => {
    e.preventDefault();
    if (!formData.name || !formData.quantity || !formData.expiryDate) return;

    const newItem = {
      id: crypto.randomUUID(),
      name: formData.name,
      category: formData.category || 'Uncategorized',
      quantity: Number(formData.quantity),
      expiryDate: formData.expiryDate,
      image: formData.image,
      icon: formData.icon,
      reminders: formData.reminders.map(r => ({...r, isNotified: false})) // reset notification status on new item
    };

    setItems(prev => [...prev, newItem].sort((a, b) => new Date(a.expiryDate) - new Date(b.expiryDate)));
    setFormData({
      name: '',
      category: categories.length > 0 ? categories[0] : 'Uncategorized',
      quantity: '',
      expiryDate: '',
      image: null,
      icon: 'general',
      reminders: [
        { id: crypto.randomUUID(), daysBefore: 30 },
        { id: crypto.randomUUID(), daysBefore: 7 },
        { id: crypto.randomUUID(), daysBefore: 1 }
      ]
    });
    setActiveTab('list');
  };

  const handleDeleteItem = (id) => {
    setItems(prev => prev.filter(item => item.id !== id));
  };

  const handleUpdateQuantity = (id, delta) => {
    setItems(prev => prev.map(item => {
      if (item.id === id) {
        return { ...item, quantity: Math.max(0, item.quantity + delta) };
      }
      return item;
    }));
  };

  const addReminder = () => {
    setFormData(prev => ({
      ...prev,
      reminders: [...prev.reminders, { id: crypto.randomUUID(), daysBefore: 3 }]
    }));
  };

  const updateReminder = (id, value) => {
    setFormData(prev => ({
      ...prev,
      reminders: prev.reminders.map(r => r.id === id ? { ...r, daysBefore: Number(value) } : r)
    }));
  };

  const removeReminder = (id) => {
    setFormData(prev => ({
      ...prev,
      reminders: prev.reminders.filter(r => r.id !== id)
    }));
  };

  // Category Handlers
  const handleAddCategory = (e) => {
    e.preventDefault();
    if (newCategory.trim() && !categories.includes(newCategory.trim())) {
      setCategories(prev => [...prev, newCategory.trim()]);
      setNewCategory('');
    }
  };

  const handleDeleteCategory = (catToDelete) => {
    if (catToDelete === 'Uncategorized') return;
    setCategories(prev => prev.filter(c => c !== catToDelete));
    setItems(prev => prev.map(item => item.category === catToDelete ? { ...item, category: 'Uncategorized' } : item));
  };

  // CSV Import/Export
  const escapeCSV = (str) => `"${String(str).replace(/"/g, '""')}"`;

  const handleExportCSV = () => {
    const headers = ["id", "name", "category", "quantity", "expiryDate", "reminders", "image", "icon"].join(",");
    const rows = items.map(item => [
      item.id,
      escapeCSV(item.name),
      escapeCSV(item.category || 'Uncategorized'),
      item.quantity,
      item.expiryDate,
      escapeCSV(JSON.stringify(item.reminders || [])),
      escapeCSV(item.image || ''),
      escapeCSV(item.icon || 'general')
    ].join(",")).join("\n");

    const csvContent = headers + "\n" + rows;
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `food_inventory_${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const fileInputRef = useRef(null);

  const handleImportCSV = (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const text = event.target.result;
        const lines = text.split("\n").filter(line => line.trim() !== "");
        if (lines.length < 2) return; // Need at least headers and one row

        const headerLine = lines[0].toLowerCase();
        const hasCategory = headerLine.includes('category');

        const parsedItems = [];
        const importedCategories = new Set(categories);

        for (let i = 1; i < lines.length; i++) {
          // Simple CSV regex to handle quotes
          const regex = /(".*?"|[^",\s]+)(?=\s*,|\s*$)/g;
          const match = lines[i].match(regex);
          if (!match) continue;

          const cols = match.map(col => col.replace(/^"|"$/g, '').replace(/""/g, '"'));

          let parsedReminders = [];
          let cat = 'Uncategorized';
          let qtyIdx = 2, expIdx = 3, remIdx = 4, imgIdx = -1, iconIdx = -1;

          if (hasCategory) {
            cat = cols[2] || 'Uncategorized';
            qtyIdx = 3;
            expIdx = 4;
            remIdx = 5;
            if (headerLine.includes('image')) {
              imgIdx = 6;
              iconIdx = 7;
            }
          }

          if (cat) importedCategories.add(cat);

          try {
            parsedReminders = cols[remIdx] ? JSON.parse(cols[remIdx]) : [];
          } catch(e) {}

          parsedItems.push({
            id: cols[0] || crypto.randomUUID(),
            name: cols[1] || 'Unknown',
            category: cat,
            quantity: Number(cols[qtyIdx]) || 0,
            expiryDate: cols[expIdx] || '',
            reminders: parsedReminders,
            image: imgIdx !== -1 && cols[imgIdx] ? cols[imgIdx] : null,
            icon: iconIdx !== -1 && cols[iconIdx] ? cols[iconIdx] : 'general'
          });
        }

        setItems(parsedItems.sort((a, b) => new Date(a.expiryDate) - new Date(b.expiryDate)));
        setCategories(Array.from(importedCategories));
        alert("Inventory imported successfully!");
      } catch (err) {
        alert("Failed to parse CSV file. Ensure it is in the correct format.");
      }
    };
    reader.readAsText(file);
    e.target.value = ''; // Reset input
  };

  // Helper to determine status color
  const getExpiryStatus = (expiryDate) => {
    const days = Math.round((new Date(expiryDate) - new Date()) / (1000 * 60 * 60 * 24));
    if (days < 0) return { tagColor: 'bg-[#E74C3C] text-white', text: 'Expired' };
    if (days === 0) return { tagColor: 'bg-[#E74C3C] text-white', text: 'Expiring Today' };
    if (days <= 7) return { tagColor: 'bg-yellow-500 text-white', text: 'Expiring Soon' };
    return { tagColor: 'bg-green-100 text-green-800', text: 'Good' };
  };

  // Filter upcoming items (expired or expiring in next 14 days), explicitly sorted
  const upcomingItems = items.filter(item => {
    const days = Math.round((new Date(item.expiryDate) - new Date()) / (1000 * 60 * 60 * 24));
    return days <= 14;
  }).sort((a, b) => new Date(a.expiryDate) - new Date(b.expiryDate));

  const filteredItems = items.filter(item =>
    item.name.toLowerCase().includes(searchQuery.toLowerCase())
  );

  // Group upcoming items for the Timeline View
  const groupedUpcoming = {};
  const searchFilteredUpcoming = upcomingItems.filter(item =>
    item.name.toLowerCase().includes(searchQuery.toLowerCase())
  );

  searchFilteredUpcoming.forEach(item => {
    const today = new Date();
    today.setHours(0,0,0,0);
    const expDate = new Date(item.expiryDate);
    expDate.setHours(0,0,0,0);
    const days = Math.round((expDate - today) / (1000 * 60 * 60 * 24));

    let groupKey = '';
    const options = { month: 'long', day: 'numeric' };
    if (days < 0) groupKey = 'Expired';
    else if (days === 0) groupKey = `Today, ${expDate.toLocaleDateString('en-US', options)}`;
    else if (days === 1) groupKey = `Tomorrow, ${expDate.toLocaleDateString('en-US', options)}`;
    else if (days <= 7) groupKey = 'Next Week';
    else groupKey = 'Later';

    if (!groupedUpcoming[groupKey]) groupedUpcoming[groupKey] = [];
    groupedUpcoming[groupKey].push(item);
  });

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col font-sans text-gray-800 selection:bg-blue-200">

      {/* Universal Header */}
      <header className="bg-[#3B71F3] text-white p-4 shadow-sm sticky top-0 z-10 transition-colors">
        <div className="flex justify-between items-center mb-3">
          <div className="flex items-center gap-2">
            <CheckCircle size={20} />
            <span className="font-semibold text-lg tracking-wide">FreshTrack</span>
          </div>
          {activeTab === 'list' && (
            <span className="text-xs bg-white bg-opacity-20 px-3 py-1 rounded-full font-medium">
              {items.length} Items
            </span>
          )}
          {activeTab === 'upcoming' && upcomingItems.length > 0 && (
            <span className="text-xs bg-red-500 px-3 py-1 rounded-full font-medium shadow-sm">
              {upcomingItems.length} Action Needed
            </span>
          )}
        </div>

        <h1 className="text-2xl font-bold mb-4">
          {activeTab === 'list' && 'All Inventory'}
          {activeTab === 'upcoming' && 'Expiring Soon Timeline'}
          {activeTab === 'add' && 'Add New Food'}
          {activeTab === 'settings' && 'App Settings'}
        </h1>

        {(activeTab === 'list' || activeTab === 'upcoming') && (
          <div className="relative">
            <Search size={20} className="absolute left-3 top-3.5 text-gray-400" />
            <input
              type="text"
              placeholder="Search food items..."
              className="w-full p-3 pl-10 rounded-xl text-gray-800 focus:outline-none shadow-inner bg-white"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
            />
            {searchQuery && (
              <button onClick={() => setSearchQuery('')} className="absolute right-3 top-3.5 text-gray-400 hover:text-gray-600">
                <X size={18} />
              </button>
            )}
          </div>
        )}
      </header>

      {/* Main Content Area */}
      <main className="flex-1 overflow-y-auto p-4 pb-24">

        {/* LIST TAB */}
        {activeTab === 'list' && (
          <div className="space-y-4 max-w-md mx-auto pt-2 px-1">
            {filteredItems.length === 0 ? (
              <div className="text-center text-gray-500 mt-16 flex flex-col items-center">
                <List size={48} className="text-gray-300 mb-4" />
                <p className="text-lg font-medium">{searchQuery ? "No matching food found" : "Your inventory is empty"}</p>
                <p className="text-sm mt-2">{searchQuery ? "Try a different search term." : "Tap the Add button below to start tracking your food."}</p>
              </div>
            ) : (
              filteredItems.map((item) => {
                const status = getExpiryStatus(item.expiryDate);
                return (
                  <div key={item.id} className="bg-white rounded-[16px] shadow-sm border border-gray-200 p-3 flex gap-4 items-center">
                    {/* Thumbnail */}
                    <div className="w-[72px] h-[72px] shrink-0 rounded-xl overflow-hidden bg-gray-50 flex items-center justify-center text-4xl border border-gray-100">
                      {item.image ? (
                        <img src={item.image} className="w-full h-full object-cover" alt={item.name} />
                      ) : (
                        <span>{FOOD_ICONS.find(i => i.id === item.icon)?.emoji || '🍽️'}</span>
                      )}
                    </div>

                    {/* Info */}
                    <div className="flex-1 min-w-0 py-1">
                      <div className="flex justify-between items-start mb-1">
                        <h4 className="font-bold text-gray-900 text-[17px] leading-tight truncate pr-2">{item.name}</h4>
                        <span className={`${status.tagColor} text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full shrink-0`}>
                          {status.text}
                        </span>
                      </div>

                      <p className="text-gray-600 text-sm">Expires: {new Date(item.expiryDate).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})}</p>
                      <p className="text-gray-500 text-xs mt-0.5 flex items-center gap-1"><Tag size={10} /> {item.category}</p>

                      <div className="flex justify-between items-center mt-3">
                        {/* Recipe Action Button */}
                        <a
                          href={`https://www.google.com/search?q=${encodeURIComponent(item.name + ' recipe')}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="bg-[#3B71F3] hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded-full flex items-center gap-1.5 transition-colors"
                        >
                          <Utensils size={12} /> Recipe Ideas
                        </a>

                        {/* Controls: Qty and Delete */}
                        <div className="flex items-center gap-3">
                          <div className="flex items-center gap-0.5 bg-gray-100 rounded-lg border border-gray-200 p-0.5">
                            <button onClick={() => handleUpdateQuantity(item.id, -1)} disabled={item.quantity <= 0} className="p-1 hover:bg-gray-200 rounded disabled:opacity-30 text-gray-600"><Minus size={14} /></button>
                            <span className="text-xs font-bold w-4 text-center">{item.quantity}</span>
                            <button onClick={() => handleUpdateQuantity(item.id, 1)} className="p-1 hover:bg-gray-200 rounded text-gray-600"><Plus size={14} /></button>
                          </div>
                          <button onClick={() => handleDeleteItem(item.id)} className="text-gray-400 hover:text-red-500 transition-colors">
                            <Trash2 size={16} />
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        )}

        {/* UPCOMING TAB (Timeline View) */}
        {activeTab === 'upcoming' && (
          <div className="max-w-md mx-auto pt-2 px-1">
            {Object.keys(groupedUpcoming).length === 0 ? (
              <div className="text-center text-gray-500 mt-10">
                <CheckCircle size={48} className="text-green-300 mx-auto mb-4" />
                <p className="text-lg font-medium">{searchQuery ? "No upcoming items match search" : "All caught up!"}</p>
                <p className="text-sm mt-2">{searchQuery ? "" : "No items are expiring soon."}</p>
              </div>
            ) : (
              <div className="relative ml-4 border-l-[3px] border-gray-300 pb-8">
                {Object.keys(groupedUpcoming).map((group, groupIdx) => (
                  <div key={group} className={`relative ${groupIdx !== 0 ? 'mt-8' : ''}`}>
                    {/* Circle indicator on the timeline */}
                    <div className="absolute -left-[11.5px] top-1 w-5 h-5 bg-gray-100 border-[3px] border-gray-400 rounded-full z-10"></div>

                    <h3 className="font-bold text-lg text-gray-900 ml-6 mb-4">{group}</h3>

                    <div className="ml-6 space-y-3">
                      {groupedUpcoming[group].map(item => {
                        const isToday = group.includes('Today');
                        const isExpired = group === 'Expired';
                        return (
                          <div key={item.id} className="bg-white rounded-[16px] shadow-sm border border-gray-200 p-3 flex gap-4 items-center">
                            {/* Thumbnail */}
                            <div className="w-[72px] h-[72px] shrink-0 rounded-xl overflow-hidden bg-gray-50 flex items-center justify-center text-4xl border border-gray-100">
                              {item.image ? (
                                <img src={item.image} className="w-full h-full object-cover" alt={item.name} />
                              ) : (
                                <span>{FOOD_ICONS.find(i => i.id === item.icon)?.emoji || '🍽️'}</span>
                              )}
                            </div>

                            {/* Info */}
                            <div className="flex-1 min-w-0 py-1">
                              <div className="flex justify-between items-start mb-1">
                                <h4 className="font-bold text-gray-900 text-[17px] leading-tight truncate pr-2">{item.name}</h4>
                                {(isToday || isExpired) && (
                                  <span className="bg-[#E74C3C] text-white text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full shrink-0">
                                    {isExpired ? 'Expired' : 'Expiring Today'}
                                  </span>
                                )}
                              </div>

                              <p className="text-gray-600 text-sm">Expires: {new Date(item.expiryDate).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})}</p>
                              <p className="text-gray-500 text-xs mt-0.5 flex items-center gap-1"><Tag size={10} /> {item.category}</p>

                              <div className="flex justify-between items-center mt-3">
                                {/* Recipe Action Button */}
                                <a
                                  href={`https://www.google.com/search?q=${encodeURIComponent(item.name + ' recipe')}`}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  className="bg-[#3B71F3] hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded-full flex items-center gap-1.5 transition-colors"
                                >
                                  <Utensils size={12} /> Recipe Ideas
                                </a>

                                {/* Controls: Qty and Delete */}
                                <div className="flex items-center gap-3">
                                  <div className="flex items-center gap-0.5 bg-gray-100 rounded-lg border border-gray-200 p-0.5">
                                    <button onClick={() => handleUpdateQuantity(item.id, -1)} disabled={item.quantity <= 0} className="p-1 hover:bg-gray-200 rounded disabled:opacity-30 text-gray-600"><Minus size={14} /></button>
                                    <span className="text-xs font-bold w-4 text-center">{item.quantity}</span>
                                    <button onClick={() => handleUpdateQuantity(item.id, 1)} className="p-1 hover:bg-gray-200 rounded text-gray-600"><Plus size={14} /></button>
                                  </div>
                                  <button onClick={() => handleDeleteItem(item.id)} className="text-gray-400 hover:text-red-500 transition-colors">
                                    <Trash2 size={16} />
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ADD TAB */}
        {activeTab === 'add' && (
          <div className="max-w-md mx-auto bg-white p-6 rounded-[16px] shadow-sm border border-gray-200">
            <form onSubmit={handleAddItem} className="space-y-5">

              {/* Image / Icon Picker Component */}
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Food Image or Icon</label>
                <div className="flex items-center gap-4 mb-4">
                  <div className="w-20 h-20 shrink-0 rounded-[16px] bg-gray-50 border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden text-4xl relative">
                    {formData.image ? (
                      <>
                        <img src={formData.image} alt="Preview" className="w-full h-full object-cover" />
                        <button type="button" onClick={() => setFormData({...formData, image: null})} className="absolute top-1 right-1 bg-white bg-opacity-90 rounded-full p-1 shadow-sm hover:bg-gray-100">
                          <X size={12} className="text-[#E74C3C]" />
                        </button>
                      </>
                    ) : (
                      <span>{FOOD_ICONS.find(i => i.id === formData.icon)?.emoji}</span>
                    )}
                  </div>
                  <div className="flex-1">
                    <label className="bg-blue-50 text-[#3B71F3] border border-blue-200 px-4 py-2.5 rounded-lg text-sm font-medium cursor-pointer hover:bg-blue-100 transition-colors flex items-center justify-center gap-2 w-full">
                      <ImageIcon size={18} /> Upload Photo
                      <input type="file" accept="image/*" className="hidden" onChange={handleImageUpload} />
                    </label>
                  </div>
                </div>

                {!formData.image && (
                  <div>
                    <p className="text-xs text-gray-500 mb-2 font-medium uppercase tracking-wider">Or select an icon:</p>
                    <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-hide pt-1">
                      {FOOD_ICONS.map(icon => (
                        <button
                          key={icon.id}
                          type="button"
                          onClick={() => setFormData({...formData, icon: icon.id})}
                          className={`w-11 h-11 shrink-0 rounded-xl text-2xl flex items-center justify-center border-2 transition-all ${formData.icon === icon.id ? 'border-[#3B71F3] bg-blue-50 shadow-sm scale-105' : 'border-gray-100 bg-white hover:bg-gray-50'}`}
                          title={icon.label}
                        >
                          {icon.emoji}
                        </button>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Food Name</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Milk, Apples, Chicken"
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3B71F3] focus:border-[#3B71F3] outline-none transition-all"
                  value={formData.name}
                  onChange={(e) => setFormData({...formData, name: e.target.value})}
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3B71F3] focus:border-[#3B71F3] outline-none transition-all bg-white"
                  value={formData.category}
                  onChange={(e) => setFormData({...formData, category: e.target.value})}
                >
                  {categories.map(cat => (
                    <option key={cat} value={cat}>{cat}</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Quantity (Numbers only)</label>
                <input
                  type="number"
                  required
                  min="1"
                  placeholder="e.g. 2"
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3B71F3] focus:border-[#3B71F3] outline-none transition-all"
                  value={formData.quantity}
                  onChange={(e) => setFormData({...formData, quantity: e.target.value})}
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Expiry Date</label>
                <input
                  type="date"
                  required
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3B71F3] focus:border-[#3B71F3] outline-none transition-all"
                  value={formData.expiryDate}
                  onChange={(e) => setFormData({...formData, expiryDate: e.target.value})}
                />
              </div>

              <div className="pt-2 border-t border-gray-100">
                <div className="flex justify-between items-center mb-3">
                  <label className="block text-sm font-medium text-gray-700">Notification Reminders</label>
                  <button type="button" onClick={addReminder} className="text-sm text-[#3B71F3] font-medium hover:text-blue-800 flex items-center gap-1">
                    <PlusCircle size={14} /> Add
                  </button>
                </div>

                {formData.reminders.length === 0 && (
                  <p className="text-xs text-gray-500 italic mb-3">No reminders set. You won't be notified for this item.</p>
                )}

                <div className="space-y-2 mb-4">
                  {formData.reminders.map((reminder) => (
                    <div key={reminder.id} className="flex items-center gap-2">
                      <span className="text-sm text-gray-600">Remind me</span>
                      <input
                        type="number"
                        min="0"
                        required
                        className="w-20 p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-[#3B71F3] outline-none text-center"
                        value={reminder.daysBefore}
                        onChange={(e) => updateReminder(reminder.id, e.target.value)}
                      />
                      <span className="text-sm text-gray-600">days before</span>
                      <button
                        type="button"
                        onClick={() => removeReminder(reminder.id)}
                        className="ml-auto p-1 text-red-400 hover:text-red-600 rounded-full hover:bg-red-50 transition-colors"
                      >
                        <X size={18} />
                      </button>
                    </div>
                  ))}
                </div>
              </div>

              <button
                type="submit"
                className="w-full bg-[#3B71F3] hover:bg-blue-700 text-white font-bold py-4 rounded-[16px] shadow-sm transition-transform active:scale-95 flex justify-center items-center gap-2"
              >
                <PlusCircle size={20} />
                Save Item
              </button>
            </form>
          </div>
        )}

        {/* SETTINGS TAB */}
        {activeTab === 'settings' && (
          <div className="max-w-md mx-auto space-y-6">

            {/* Category Management */}
            <div className="bg-white p-6 rounded-[16px] shadow-sm border border-gray-200">
              <h2 className="text-xl font-bold mb-4 flex items-center gap-2 text-gray-800">
                <Tag size={20} className="text-[#3B71F3]" />
                Food Categories
              </h2>

              <form onSubmit={handleAddCategory} className="flex gap-2 mb-4">
                <input
                  type="text"
                  placeholder="New category name..."
                  className="flex-1 p-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3B71F3] outline-none"
                  value={newCategory}
                  onChange={(e) => setNewCategory(e.target.value)}
                />
                <button type="submit" className="bg-[#3B71F3] text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700 transition-colors">
                  Add
                </button>
              </form>

              <div className="space-y-2 max-h-48 overflow-y-auto pr-2">
                {categories.map(cat => (
                  <div key={cat} className="flex justify-between items-center p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <span className="font-medium text-gray-700">{cat}</span>
                    {cat !== 'Uncategorized' && (
                      <button
                        onClick={() => handleDeleteCategory(cat)}
                        className="text-red-500 hover:bg-red-50 p-2 rounded-md transition-colors"
                        title="Delete Category"
                      >
                        <Trash2 size={16} />
                      </button>
                    )}
                  </div>
                ))}
              </div>
              <p className="text-xs text-gray-500 mt-3 italic">Deleting a category will automatically move its items to "Uncategorized".</p>
            </div>

            {/* Notification Settings */}
            <div className="bg-white p-6 rounded-[16px] shadow-sm border border-gray-200">
              <h2 className="text-xl font-bold mb-4 flex items-center gap-2 text-gray-800">
                <Bell size={20} className="text-[#3B71F3]" />
                System Notifications
              </h2>

              <div className="mb-2">
                <button
                  onClick={requestNotificationPermission}
                  className={`w-full py-2 px-4 rounded-lg font-medium transition-colors ${notificationPermission === 'granted' ? 'bg-green-100 text-green-800 border border-green-300' : 'bg-blue-50 text-[#3B71F3] border border-blue-200 hover:bg-blue-100'}`}
                >
                  {notificationPermission === 'granted' ? 'Push Notifications Active' : 'Enable Push Notifications'}
                </button>
              </div>
              <p className="text-xs text-gray-500 mb-4">
                Global settings have been moved. You now configure specific notification schedules per-item when adding food.
              </p>
            </div>

            {/* Data Management (Local Storage via CSV) */}
            <div className="bg-white p-6 rounded-[16px] shadow-sm border border-gray-200">
              <h2 className="text-xl font-bold mb-4 flex items-center gap-2 text-gray-800">
                <Download size={20} className="text-[#3B71F3]" />
                Local Data Storage
              </h2>
              <p className="text-sm text-gray-600 mb-4">
                To keep your data strictly on your device, export your inventory to a CSV file. You can import it later to restore your data.
              </p>

              <div className="space-y-3">
                <button
                  onClick={handleExportCSV}
                  className="w-full bg-[#3B71F3] hover:bg-blue-700 text-white font-medium py-3 rounded-[16px] flex justify-center items-center gap-2 transition-colors shadow-sm"
                >
                  <Download size={18} />
                  Export to CSV (Save)
                </button>

                <input
                  type="file"
                  accept=".csv"
                  className="hidden"
                  ref={fileInputRef}
                  onChange={handleImportCSV}
                />

                <button
                  onClick={() => fileInputRef.current?.click()}
                  className="w-full bg-white hover:bg-gray-50 text-gray-800 border border-gray-300 font-medium py-3 rounded-[16px] flex justify-center items-center gap-2 transition-colors shadow-sm"
                >
                  <Upload size={18} />
                  Import from CSV (Load)
                </button>
              </div>
            </div>

          </div>
        )}

      </main>

      {/* Bottom Navigation */}
      <nav className="bg-white border-t border-gray-200 fixed bottom-0 w-full z-20 pb-safe">
        <div className="flex justify-around items-center max-w-md mx-auto">
          <button
            onClick={() => setActiveTab('list')}
            className={`flex-1 py-4 flex flex-col items-center gap-1 transition-colors ${activeTab === 'list' ? 'text-[#3B71F3]' : 'text-gray-400 hover:text-gray-600'}`}
          >
            <List size={24} />
            <span className="text-xs font-medium">Inventory</span>
          </button>

          <button
            onClick={() => setActiveTab('upcoming')}
            className={`flex-1 py-4 flex flex-col items-center gap-1 transition-colors ${activeTab === 'upcoming' ? 'text-[#3B71F3]' : 'text-gray-400 hover:text-gray-600'}`}
          >
            <div className="relative">
              <CalendarDays size={24} />
              {upcomingItems.length > 0 && (
                <span className="absolute -top-1 -right-2 bg-red-500 w-4 h-4 rounded-full border-2 border-white"></span>
              )}
            </div>
            <span className="text-xs font-medium">Upcoming</span>
          </button>

          <button
            onClick={() => setActiveTab('add')}
            className={`flex-1 py-4 flex flex-col items-center gap-1 transition-colors ${activeTab === 'add' ? 'text-[#3B71F3]' : 'text-gray-400 hover:text-gray-600'}`}
          >
            <div className={`p-2 rounded-full ${activeTab === 'add' ? 'bg-blue-50' : 'bg-transparent'}`}>
              <PlusCircle size={28} />
            </div>
            <span className="text-xs font-medium -mt-1">Add Food</span>
          </button>

          <button
            onClick={() => setActiveTab('settings')}
            className={`flex-1 py-4 flex flex-col items-center gap-1 transition-colors ${activeTab === 'settings' ? 'text-[#3B71F3]' : 'text-gray-400 hover:text-gray-600'}`}
          >
            <Settings size={24} />
            <span className="text-xs font-medium">Settings</span>
          </button>
        </div>
      </nav>

    </div>
  );
}